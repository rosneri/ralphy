{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "promise"],
  "rules": {
    "no-explicit-any": "error",
    "import/no-cycle": "error",
    "no-console": "warn",
    "no-restricted-imports": [
      "warn",
      {
        "paths": [
          {
            "name": "node:fs",
            "importNames": [
              "readFileSync",
              "writeFileSync",
              "appendFileSync",
              "existsSync",
              "unlinkSync",
              "renameSync",
              "mkdirSync",
              "rmdirSync",
              "rmSync",
              "readdirSync",
              "statSync",
              "lstatSync",
              "copyFileSync",
              "cpSync",
              "accessSync",
              "chmodSync",
              "openSync",
              "closeSync",
              "readSync",
              "writeSync",
              "realpathSync",
              "truncateSync",
              "symlinkSync",
              "readlinkSync",
              "mkdtempSync",
              "utimesSync",
              "opendirSync"
            ],
            "message": "node:fs *Sync APIs are banned — use Bun.file(p).text() / Bun.write(p, data) / await Bun.file(p).exists() or async node:fs/promises."
          },
          {
            "name": "node:crypto",
            "importNames": ["createHash"],
            "message": "node:crypto createHash is banned — use new Bun.CryptoHasher(algo)."
          },
          {
            "name": "node:fs/promises",
            "importNames": ["exists"],
            "message": "the deprecated node:fs/promises exists is banned — use await Bun.file(p).exists()."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/features/**", "**/capabilities/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/runtime/**", "**/consumers/**"],
                "message": "features must not import runtime/consumers"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/consumers/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/features/**", "**/capabilities/**"],
                "message": "consumers must not import features/capabilities"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.spec.ts"],
      "rules": {
        "no-console": "off",
        "no-control-regex": "off",
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["**/detect.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["**/*linear*"], "message": "detect.ts must be I/O-free" },
              { "group": ["**/*gh-client*"], "message": "detect.ts must be I/O-free" },
              { "group": ["**/git*"], "message": "detect.ts must be I/O-free" },
              { "group": ["node:child_process"], "message": "detect.ts must be I/O-free" }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["node_modules", "dist", ".husky"]
}
