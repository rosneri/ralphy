{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": [
    "@rosneri/xstate-mcp",
    "@secretlint/secretlint-rule-preset-recommend",
    "@fission-ai/openspec",
    "@nx/js",
    "@total-typescript/ts-reset",
    "@rosneri/xstate-mcp"
  ],
  "ignore": ["reset.d.ts", "scripts/debug-agent.ts", "scripts/xstate-mcp-server.ts"],
  "workspaces": {
    ".": {
      "entry": [".claude/hooks/__tests__/**/*.{ts,tsx}", "scripts/__tests__/**/*.ts"]
    },
    "apps/init": {
      "entry": ["src/**/__tests__/**/*.{ts,tsx}"]
    },
    "apps/loop": {
      "entry": ["src/**/__tests__/**/*.{ts,tsx}"]
    },
    "apps/agent": {
      "entry": [
        "src/**/__tests__/**/*.{ts,tsx}",
        "test/**/__tests__/**/*.{ts,tsx}",
        "test/harness/index.ts"
      ]
    },
    "apps/shell": {
      "entry": ["src/index.ts", "build.ts"]
    },
    "packages/cli-args": {
      "entry": ["src/**/*.ts"]
    },
    "packages/paths": {
      "entry": ["src/**/*.ts"]
    },
    "packages/version": {
      "entry": ["src/**/*.ts"]
    },
    "apps/mcp": {
      "entry": ["src/index.ts", "src/__tests__/**/*.ts"]
    },
    "apps/ui": {
      "entry": [
        "src-sidecar/server.ts",
        "src/components/**/*.tsx",
        "src/components/**/*.test.ts",
        "src/lib/**/*.ts"
      ]
    },
    "packages/content": {
      "entry": ["src/**/*.ts"]
    },
    "packages/context": {
      "entry": ["src/**/*.ts"]
    },
    "packages/log": {
      "entry": ["src/**/*.ts"]
    },
    "packages/core": {
      "entry": ["src/**/*.ts!"]
    },
    "packages/engine": {
      "entry": ["src/**/*.ts"]
    },
    "packages/retro": {
      "entry": ["src/**/*.ts", "src/__tests__/**/*.ts"]
    },
    "packages/adapter-codex": {
      "entry": ["src/**/*.ts", "src/__tests__/**/*.ts"]
    },
    "packages/openspec": {
      "entry": ["src/**/*.ts"]
    },
    "packages/output": {
      "entry": ["src/**/*.ts"]
    },
    "packages/types": {
      "entry": ["src/**/*.ts"]
    },
    "packages/telemetry": {
      "entry": ["src/**/*.ts", "src/__tests__/**/*.ts"]
    },
    "packages/workflow": {
      "entry": ["src/**/*.ts", "src/__tests__/**/*.ts"]
    },
    "packages/agent-protocol": {
      "entry": ["src/**/*.ts", "src/__tests__/**/*.ts"]
    },
    "packages/events": {
      "entry": ["src/**/*.ts", "src/__tests__/**/*.ts"]
    },
    "packages/comms": {
      "entry": ["src/**/*.ts"]
    }
  }
}
