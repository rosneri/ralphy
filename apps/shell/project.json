{
  "name": "shell",
  "sourceRoot": "apps/shell/src",
  "tags": ["scope:shell"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint --config .oxlintrc.json apps/shell/src",
        "cwd": "{workspaceRoot}"
      }
    },
    "fmt:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxfmt --check apps/shell/src",
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run apps/shell/build.ts",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/dist/shell"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b apps/shell/tsconfig.json",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
